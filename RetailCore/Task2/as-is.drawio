        <mxCell id="uvLOLULA7igJ2ZsBBFsL-6" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div&gt; &lt;b class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;ORACLE OLTB&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot;&gt;&lt;i&gt;(Operational Legacy Database)&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot;&gt;&lt;i&gt;a&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Это критический элемент. Он содержит:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;О&lt;/span&gt;&lt;span class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;перационные данные заказов&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;: таблицы ORDERS, ORDER_STATUS_HISTORY.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span class=&quot;Strong-styled__StyledStrong-sc-927c6ee2-0 ivHeos&quot; style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Бизнес-правила и пакеты&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;: LEGACY.promo_pkg, LEGACY.order_status_history, процедуры резервирования.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;s