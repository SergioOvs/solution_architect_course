@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Component Diagram — Bidding Service

Container_Boundary(bidding_service, "Bidding Service") {
    Component(grpc_server, "gRPC server", "Go/C++", "Принимает EvaluateRequest от Ad Server")
    Component(auction_engine, "Auction Engine", "Core", "Применяет бизнес-правила, взвешивает ставки, выбирает победителя")
    Component(budget_client, "Budget client", "gRPC Client", "Атомарно резервирует бюджет через ReserveBudget")
    Component(redis_client, "Redis client", "Redis Protocol", "Читает hot data (bid multipliers, floor prices)")
    Component(kafka_producer, "Kafka producer", "Kafka API", "Асинхронно публикует auction.win-loss")

    Component(bidding_db_client, "BiddingDB Client", "JDBC", "Читает/пишет конфигурацию правил")

    Rel(grpc_server, auction_engine, "Передает кандидатов")
    Rel(auction_engine, redis_client, "Запрашивает конфигурацию")
    Rel(auction_engine, budget_client, "Резервирует бюджет (ReserveBudget)")
    Rel(auction_engine, kafka_producer, "Отправляет результат аукциона")
    Rel(auction_engine, bidding_db_client, "Синхронизирует конфигурацию")
}

Container(ad_server, "Ad Server", "C++, Go", "Подбирает кандидатов")
Container(budget_service, "Budget Service", "Go", "Управляет бюджетами")
ContainerDb(redis, "Redis Cluster", "Redis", "Кэш hot data")
SystemQueue(kafka, "Kafka Cluster", "Kafka", "")
ContainerDb(bidding_db, "BiddingDB", "PostgreSQL", "Конфигурация аукционов")

Rel(ad_server, grpc_server, "gRPC Evaluate()")
Rel(budget_client, budget_service, "gRPC ReserveBudget()")
Rel(redis_client, redis, "MGET / GET")
Rel(kafka_producer, kafka, "Publish to auction.win-loss")
Rel(bidding_db_client, bidding_db, "JDBC")

@enduml